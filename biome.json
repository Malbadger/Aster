{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": false },
  "files": {
    "ignore": [
      "dist/**",
      "node_modules/**",
      "benchmarks/fixtures/**",
      "work/**",
      "apps/**",
      "packages/**",
      "scripts/desktop/**"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "off", "noConsoleLog": "off" },
      "style": { "useNodejsImportProtocol": "error", "noNonNullAssertion": "off", "useImportType": "warn" },
      "complexity": { "noForEach": "off" }
    }
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always", "trailingCommas": "all" } }
}
