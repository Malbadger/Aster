{
  "$schema": "vscode://schemas/color-theme",
  "name": "Aster Graphite",
  "type": "dark",
  "include": "./one-dark-pro-color-theme.json",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#17161a",
    "editor.foreground": "#ece9f0",
    "editorGroupHeader.tabsBackground": "#111015",
    "tab.activeBackground": "#17161a",
    "tab.inactiveBackground": "#111015",
    "titleBar.activeBackground": "#111015",
    "titleBar.activeForeground": "#ece9f0",
    "activityBar.background": "#111015",
    "activityBar.foreground": "#ece9f0",
    "activityBarBadge.background": "#4fb6a6",
    "activityBarBadge.foreground": "#101815",
    "sideBar.background": "#111015",
    "sideBar.foreground": "#c8c3ce",
    "sideBarTitle.foreground": "#ece9f0",
    "statusBar.background": "#177f72",
    "statusBar.foreground": "#ffffff",
    "panel.background": "#111015",
    "panel.border": "#35323b",
    "terminal.background": "#111015",
    "terminal.foreground": "#ece9f0",
    "input.background": "#1e1c22",
    "input.foreground": "#ece9f0",
    "dropdown.background": "#1e1c22",
    "dropdown.foreground": "#ece9f0",
    "button.background": "#4fb6a6",
    "button.foreground": "#101815",
    "focusBorder": "#4fb6a6"
  }
}
