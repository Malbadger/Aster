{
  "$schema": "vscode://schemas/color-theme",
  "name": "Tokyo Night",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#1a1b26",
    "editor.foreground": "#a9b1d6",
    "editorLineNumber.foreground": "#3b4261",
    "editorLineNumber.activeForeground": "#a9b1d6",
    "editor.lineHighlightBackground": "#24283b",
    "editor.selectionBackground": "#7aa2f733",
    "editor.inactiveSelectionBackground": "#7aa2f722",
    "editorCursor.foreground": "#7aa2f7",
    "editorWhitespace.foreground": "#3b426155",
    "editorIndentGuide.background1": "#3b426144",
    "editorIndentGuide.activeBackground1": "#3b4261",
    "editor.findMatchBackground": "#7aa2f766",
    "editor.findMatchHighlightBackground": "#7aa2f733",
    "editorBracketMatch.background": "#7aa2f733",
    "editorBracketMatch.border": "#7aa2f7",
    "editorGroupHeader.tabsBackground": "#16161e",
    "editorGroup.border": "#a9b1d612",
    "tab.activeBackground": "#1a1b26",
    "tab.inactiveBackground": "#16161e",
    "tab.activeForeground": "#a9b1d6",
    "tab.inactiveForeground": "#787c99",
    "tab.activeBorderTop": "#7aa2f7",
    "tab.border": "#16161e",
    "titleBar.activeBackground": "#16161e",
    "titleBar.activeForeground": "#787c99",
    "titleBar.inactiveBackground": "#16161e",
    "titleBar.inactiveForeground": "#787c99aa",
    "activityBar.background": "#16161e",
    "activityBar.foreground": "#a9b1d6",
    "activityBar.inactiveForeground": "#787c99",
    "activityBarBadge.background": "#7aa2f7",
    "activityBarBadge.foreground": "#1a1b26",
    "sideBar.background": "#16161e",
    "sideBar.foreground": "#787c99",
    "sideBarTitle.foreground": "#a9b1d6",
    "sideBarSectionHeader.background": "#16161e",
    "sideBarSectionHeader.foreground": "#a9b1d6",
    "list.activeSelectionBackground": "#7aa2f733",
    "list.activeSelectionForeground": "#a9b1d6",
    "list.hoverBackground": "#a9b1d60d",
    "list.highlightForeground": "#7aa2f7",
    "statusBar.background": "#16161e",
    "statusBar.foreground": "#787c99",
    "statusBar.noFolderBackground": "#16161e",
    "statusBar.debuggingBackground": "#7aa2f7",
    "statusBar.debuggingForeground": "#1a1b26",
    "panel.background": "#1a1b26",
    "panel.border": "#a9b1d612",
    "panelTitle.activeForeground": "#a9b1d6",
    "panelTitle.inactiveForeground": "#787c99",
    "terminal.background": "#1a1b26",
    "terminal.foreground": "#a9b1d6",
    "terminalCursor.foreground": "#7aa2f7",
    "input.background": "#16161e",
    "input.foreground": "#a9b1d6",
    "input.border": "#a9b1d61a",
    "dropdown.background": "#16161e",
    "dropdown.foreground": "#a9b1d6",
    "button.background": "#7aa2f7",
    "button.foreground": "#1a1b26",
    "button.hoverBackground": "#7aa2f7dd",
    "focusBorder": "#7aa2f788",
    "badge.background": "#7aa2f7",
    "badge.foreground": "#1a1b26",
    "scrollbarSlider.background": "#a9b1d622",
    "scrollbarSlider.hoverBackground": "#a9b1d633",
    "scrollbarSlider.activeBackground": "#a9b1d644",
    "widget.shadow": "#00000044",
    "editorWidget.background": "#16161e",
    "editorHoverWidget.background": "#16161e",
    "editorSuggestWidget.background": "#16161e",
    "editorSuggestWidget.selectedBackground": "#7aa2f733",
    "peekViewEditor.background": "#1a1b26",
    "editorError.foreground": "#bb9af7",
    "editorWarning.foreground": "#ff9e64",
    "gitDecoration.modifiedResourceForeground": "#7aa2f7",
    "gitDecoration.deletedResourceForeground": "#bb9af7",
    "gitDecoration.untrackedResourceForeground": "#9ece6a",
    "gitDecoration.ignoredResourceForeground": "#3b4261"
  },
  "tokenColors": [
    {
      "scope": [],
      "settings": {
        "foreground": "#a9b1d6",
        "background": "#1a1b26"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#565f89",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "modifier"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9ece6a"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#ff9e64"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other"
      ],
      "settings": {
        "foreground": "#ff9e64"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#7aa2f7"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable.name",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#a9b1d6"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.other.parameter"
      ],
      "settings": {
        "foreground": "#c0caf5",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7aa2f7"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#7dcfff"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#7aa2f7",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ff9e64",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#bb9af7",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#9ece6a"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7dcfff",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#bb9af7"
      }
    },
    {
      "scope": [
        "variable.language.this",
        "variable.language"
      ],
      "settings": {
        "foreground": "#ff9e64",
        "fontStyle": "italic"
      }
    }
  ]
}