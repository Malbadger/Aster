{
  "$schema": "vscode://schemas/color-theme",
  "name": "GitHub Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#0d1117",
    "editor.foreground": "#c9d1d9",
    "editorLineNumber.foreground": "#484f58",
    "editorLineNumber.activeForeground": "#c9d1d9",
    "editor.lineHighlightBackground": "#161b22",
    "editor.selectionBackground": "#58a6ff33",
    "editor.inactiveSelectionBackground": "#58a6ff22",
    "editorCursor.foreground": "#58a6ff",
    "editorWhitespace.foreground": "#484f5855",
    "editorIndentGuide.background1": "#484f5844",
    "editorIndentGuide.activeBackground1": "#484f58",
    "editor.findMatchBackground": "#58a6ff66",
    "editor.findMatchHighlightBackground": "#58a6ff33",
    "editorBracketMatch.background": "#58a6ff33",
    "editorBracketMatch.border": "#58a6ff",
    "editorGroupHeader.tabsBackground": "#010409",
    "editorGroup.border": "#c9d1d912",
    "tab.activeBackground": "#0d1117",
    "tab.inactiveBackground": "#010409",
    "tab.activeForeground": "#c9d1d9",
    "tab.inactiveForeground": "#8b949e",
    "tab.activeBorderTop": "#58a6ff",
    "tab.border": "#010409",
    "titleBar.activeBackground": "#010409",
    "titleBar.activeForeground": "#8b949e",
    "titleBar.inactiveBackground": "#010409",
    "titleBar.inactiveForeground": "#8b949eaa",
    "activityBar.background": "#010409",
    "activityBar.foreground": "#c9d1d9",
    "activityBar.inactiveForeground": "#8b949e",
    "activityBarBadge.background": "#58a6ff",
    "activityBarBadge.foreground": "#0d1117",
    "sideBar.background": "#010409",
    "sideBar.foreground": "#8b949e",
    "sideBarTitle.foreground": "#c9d1d9",
    "sideBarSectionHeader.background": "#010409",
    "sideBarSectionHeader.foreground": "#c9d1d9",
    "list.activeSelectionBackground": "#58a6ff33",
    "list.activeSelectionForeground": "#c9d1d9",
    "list.hoverBackground": "#c9d1d90d",
    "list.highlightForeground": "#58a6ff",
    "statusBar.background": "#010409",
    "statusBar.foreground": "#8b949e",
    "statusBar.noFolderBackground": "#010409",
    "statusBar.debuggingBackground": "#58a6ff",
    "statusBar.debuggingForeground": "#0d1117",
    "panel.background": "#0d1117",
    "panel.border": "#c9d1d912",
    "panelTitle.activeForeground": "#c9d1d9",
    "panelTitle.inactiveForeground": "#8b949e",
    "terminal.background": "#0d1117",
    "terminal.foreground": "#c9d1d9",
    "terminalCursor.foreground": "#58a6ff",
    "input.background": "#010409",
    "input.foreground": "#c9d1d9",
    "input.border": "#c9d1d91a",
    "dropdown.background": "#010409",
    "dropdown.foreground": "#c9d1d9",
    "button.background": "#58a6ff",
    "button.foreground": "#0d1117",
    "button.hoverBackground": "#58a6ffdd",
    "focusBorder": "#58a6ff88",
    "badge.background": "#58a6ff",
    "badge.foreground": "#0d1117",
    "scrollbarSlider.background": "#c9d1d922",
    "scrollbarSlider.hoverBackground": "#c9d1d933",
    "scrollbarSlider.activeBackground": "#c9d1d944",
    "widget.shadow": "#00000044",
    "editorWidget.background": "#010409",
    "editorHoverWidget.background": "#010409",
    "editorSuggestWidget.background": "#010409",
    "editorSuggestWidget.selectedBackground": "#58a6ff33",
    "peekViewEditor.background": "#0d1117",
    "editorError.foreground": "#ff7b72",
    "editorWarning.foreground": "#79c0ff",
    "gitDecoration.modifiedResourceForeground": "#d2a8ff",
    "gitDecoration.deletedResourceForeground": "#ff7b72",
    "gitDecoration.untrackedResourceForeground": "#a5d6ff",
    "gitDecoration.ignoredResourceForeground": "#484f58"
  },
  "tokenColors": [
    {
      "scope": [],
      "settings": {
        "foreground": "#c9d1d9",
        "background": "#0d1117"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#8b949e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other",
        "modifier"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a5d6ff"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "scope": [
        "constant.character.escape",
        "constant.other"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#d2a8ff"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "entity.name.type.class"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other.readwrite",
        "meta.definition.variable.name",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#c9d1d9"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.other.parameter"
      ],
      "settings": {
        "foreground": "#ffa657",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#d2a8ff"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#79c0ff"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#d2a8ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#79c0ff",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#ff7b72",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#a5d6ff"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#79c0ff",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#ff7b72"
      }
    },
    {
      "scope": [
        "variable.language.this",
        "variable.language"
      ],
      "settings": {
        "foreground": "#79c0ff",
        "fontStyle": "italic"
      }
    }
  ]
}